---
// Componente de Chatbot Legal Inteligente
---
<div class="chatbot-widget" id="chatbotWidget">
  <!-- Ventana de Chat -->
  <div class="chatbot-window" id="chatbotWindow">
    <div class="chatbot-header">
      <div class="chatbot-header-info">
        <div class="chatbot-avatar">
          <i class="fa-solid fa-scale-balanced"></i>
          <span class="status-dot"></span>
        </div>
        <div class="chatbot-title">
          <h4>Asistente Valor & Asoc.</h4>
          <span>En línea • Jurisdicción Argentina</span>
        </div>
      </div>
      <div class="chatbot-actions">
        <button class="chat-btn-icon" id="chatbotClose" aria-label="Cerrar chat">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <div class="chatbot-messages" id="chatbotMessages">
      <!-- Mensajes inyectados dinámicamente -->
    </div>

    <div class="chatbot-footer">
      <div class="chatbot-input-row">
        <input type="text" id="chatbotInput" class="chatbot-input" placeholder="Escribí tu consulta o duda..." />
        <button id="chatbotSend" class="chatbot-send-btn" aria-label="Enviar">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Gatillador Flotante -->
  <button class="chatbot-trigger" id="chatbotTrigger" aria-label="Abrir asistente legal">
    <i class="fa-solid fa-comment-dots"></i>
    <span class="chatbot-badge-alert" id="chatbotBadge">1</span>
  </button>
</div>
