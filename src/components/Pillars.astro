// Componente Pilares de Confianza Institucional
---
<section class="pillars-bar">
  <div class="container">
    <div class="pillars-grid">
      <div class="pillar-item">
        <div class="pillar-icon">
          <i class="fa-solid fa-user-shield"></i>
        </div>
        <div class="pillar-text">
          <h4>Atención Personalizada</h4>
          <p>Estrategias jurídicas a la medida exacta de tu caso y tu familia.</p>
        </div>
      </div>
      <div class="pillar-item">
        <div class="pillar-icon">
          <i class="fa-solid fa-lock"></i>
        </div>
        <div class="pillar-text">
          <h4>Confidencialidad Absoluta</h4>
          <p>Secreto profesional estricto en cada expediente y consulta.</p>
        </div>
      </div>
      <div class="pillar-item">
        <div class="pillar-icon">
          <i class="fa-solid fa-award"></i>
        </div>
        <div class="pillar-text">
          <h4>Experiencia Comprobada</h4>
          <p>Años de trayectoria defendiendo derechos en tribunales de todo el país.</p>
        </div>
      </div>
    </div>
  </div>
</section>
